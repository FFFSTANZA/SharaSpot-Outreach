#!/usr/bin/expect -f

set timeout 300
set ip "194.59.165.179"
set password "Jreit2@,Id;@UA5-"

spawn ssh -o StrictHostKeyChecking=no root@$ip

expect "password:"
send "$password\r"

expect "#"

# Update systems
send "apt update && apt upgrade -y\r"
expect "#"

# Install Docker
send "apt install docker.io docker-compose -y\r"
expect "#"
send "systemctl enable --now docker\r"
expect "#"

# Install NVM and Node 22
send "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash\r"
expect "#"
send "export NVM_DIR=\"\$HOME/.nvm\"\r"
send "\[ -s \"\$NVM_DIR/nvm.sh\" \] && \\. \"\$NVM_DIR/nvm.sh\"\r"
send "nvm install 22\r"
expect "#"

# Install PM2
send "npm install -g pm2\r"
expect "#"

# Install Nginx
send "apt install nginx -y\r"
expect "#"
send "systemctl enable --now nginx\r"
expect "#"

# Firewall
send "ufw allow ssh\r"
expect "#"
send "ufw allow http\r"
expect "#"
send "ufw allow https\r"
expect "#"
send "echo \"y\" | ufw enable\r"
expect "#"

send "exit\r"
expect eof
