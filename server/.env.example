# ─── SharaSpot Server — Production Environment ───
# Copy this file to .env and fill in the values.
# Generate secrets with: openssl rand -hex 32

PORT=8000
NODE_ENV=production

# ─── PostgreSQL (Local on VPS) ───
DATABASE_URL=postgresql://sharaspot:YOUR_DB_PASSWORD@localhost:5432/sharaspot

# ─── Redis (Local on VPS) ───
# If Redis has a password: redis://:YOUR_REDIS_PASSWORD@localhost:6379
REDIS_URL=redis://localhost:6379

# ─── Encryption key for credentials ───
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Auth secrets ───
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Google sign-in Client ID ───
GOOGLE_CLIENT_ID=354664818470-veljl4900p28hf0i81u0r959ra11ihjt.apps.googleusercontent.com

# ─── Supabase Storage (attachments ONLY — no DB, no auth) ───
# Project URL from Supabase Dashboard → Settings → API
SUPABASE_URL=https://pbmklbvktpbzbvzpamlu.supabase.co
# service_role key from Supabase Dashboard → Settings → API
SUPABASE_SERVICE_ROLE_KEY=
# Bucket name (must be public)
SUPABASE_BUCKET_NAME=sharaspot-attachments

# ─── Tracking Base URL ───
# Public URL of your server (used for open/click tracking in emails)
TRACKING_BASE_URL=https://YOUR_DOMAIN

# ─── Worker configuration ───
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000

# ─── Reply Detection ───
REPLY_CHECK_INTERVAL_MS=300000
REPLY_LOOKBACK_HOURS=24
ADAPTIVE_POLL_WINDOW_HOURS=48
IMAP_POOL_REUSE_MS=45000
IMAP_IDLE_TIMEOUT_MS=1740000

# ─── Tracking Buffer ───
TRACKING_BATCH_SIZE=100
TRACKING_FLUSH_INTERVAL_MS=5000

# ─── Tracking Data Pruning ───
TRACKING_PRUNE_AFTER_DAYS=30
TRACKING_PRUNE_BATCH_SIZE=5000

# ─── Stale Job Recovery ───
STALE_SENDING_THRESHOLD_MS=300000
STALE_SWEEP_INTERVAL_MS=120000

# ─── Sequence Scheduler ───
SEQUENCE_SCHEDULER_INTERVAL_MS=900000
AUTO_RESUME_INTERVAL_MS=3600000

# ─── Warmup duration in days ───
# WARMUP_DURATION_DAYS=28
