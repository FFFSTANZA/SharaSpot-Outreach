# ─── SharaSpot Server — Production Environment ───
# Copy this file to .env and fill in the values.
# Generate secrets with: openssl rand -hex 32

PORT=8000
NODE_ENV=production

# ─── PostgreSQL (Local on VPS) ───
DATABASE_URL=postgresql://sharaspot:YOUR_DB_PASSWORD@localhost:5432/sharaspot

# ─── Redis (Local on VPS) ───
# If Redis has a password: redis://:YOUR_REDIS_PASSWORD@localhost:6379
REDIS_URL=redis://localhost:6379

# ─── Encryption key for credentials ───
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Auth secrets ───
# Generate: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=1h
REFRESH_TOKEN_EXPIRES=30d

# ─── Google sign-in Client ID ───
# Replace with your actual Google OAuth Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Tracking Base URL ───
# Public URL of your server (used for open/click tracking in emails)
TRACKING_BASE_URL=https://sharaspot.in
# DNS target users should CNAME their branded tracking subdomain to.
# If omitted, the server falls back to the hostname from TRACKING_BASE_URL.
TRACKING_CNAME_TARGET=sharaspot.in
# Comma-separated list of allowed redirect domains for click tracking.
# When set, only these domains (and subdomains) will be redirected to.
# Recommended for production to prevent open redirect vulnerabilities.
# Example: ALLOWED_REDIRECT_DOMAINS=example.com,myapp.com
# ALLOWED_REDIRECT_DOMAINS=

# ─── Worker configuration ───
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000

# ─── Reply Detection ───
REPLY_CHECK_INTERVAL_MS=300000
REPLY_LOOKBACK_HOURS=24
ADAPTIVE_POLL_WINDOW_HOURS=48
IMAP_POOL_REUSE_MS=45000
IMAP_IDLE_TIMEOUT_MS=1740000

# ─── DNS resolution timeout for tracking domain CNAME verification ───
DNS_TIMEOUT_MS=10000

# ─── Tracking Buffer ───
TRACKING_BATCH_SIZE=100
TRACKING_FLUSH_INTERVAL_MS=5000

# ─── Tracking Data Pruning (events older than N days are deleted from DB) ───
TRACKING_PRUNE_AFTER_DAYS=30
TRACKING_PRUNE_BATCH_SIZE=5000

# ─── Stale Job Recovery ───
STALE_SENDING_THRESHOLD_MS=300000
STALE_SWEEP_INTERVAL_MS=120000

# ─── Sequence Scheduler ───
SEQUENCE_SCHEDULER_INTERVAL_MS=900000
AUTO_RESUME_INTERVAL_MS=3600000

# ─── Warmup duration in days ───
# WARMUP_DURATION_DAYS=28

# ─── Local file storage (attachments) ───
# Directory where uploaded files are stored, relative to CWD
# UPLOAD_DIR=uploads

# ─── Dodo Payments (Premium Subscriptions) ───
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID_GLOBAL=
DODO_PRODUCT_ID_INDIA=
DODO_ENVIRONMENT=production

# ─── Sentry Error Monitoring (optional) ───
# Get your DSN from https://sentry.io
# SENTRY_DSN=https://your-dsn@sentry.io/your-project

# ─── Frontend URL (for payment redirects) ───
FRONTEND_URL=https://sharaspot.in
# Optional extra CORS origins (comma-separated)
# CORS_ORIGIN=http://localhost,http://127.0.0.1:3000

# Local HTTP cookie overrides. Keep production on secure cookies unless you
# explicitly know you need otherwise.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax

# ─── Admin Dashboard Secret ───
# Secret key to access admin metrics API
# Generate: openssl rand -hex 32
ADMIN_SECRET_KEY=
