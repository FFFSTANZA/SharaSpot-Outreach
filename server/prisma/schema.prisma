datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())

  senders       Sender[]
  campaigns     EmailCampaign[]
  refreshTokens RefreshToken[]
  templates     EmailTemplate[]
  subscription  Subscription?

  // Enhanced Compose relations
  templateFolders   TemplateFolder[]
  templateShares    TemplateShare[]    @relation("UserTemplateShares")
  templateFavorites TemplateFavorite[]
  contentSnippets   ContentSnippet[]
  emailSignatures   EmailSignature[]
  brandKit          BrandKit?
  savedBlocks       SavedBlock[]
  draftShares       DraftShare[]
  draftComments     DraftComment[]
  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  approvalsToGive   ApprovalRequest[]  @relation("ApprovalsToGive")
  textExpanders     TextExpander[]
  webhooks          Webhook[]
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  ON_HOLD
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  dodoCustomerId         String?
  dodoSubscriptionId     String?
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelAt               DateTime?
  trialEnd               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([dodoSubscriptionId])
  @@index([status])
}

model Sender {
  id     String  @id @default(cuid())
  userId String
  email  String
  name   String?

  // Encrypted App Password (AES-256-CBC format: "iv_hex:ciphertext_hex").
  appPassword String @default("")

  // SMTP server configuration
  smtpHost String @default("smtp.gmail.com")
  smtpPort Int    @default(465)

  // Whether SMTP credentials have been verified
  isVerified Boolean @default(false)

  // Maximum emails this sender can send per day
  dailyLimit Int @default(500)

  // Per-sender hourly limit
  hourlyLimit Int?

  createdAt DateTime @default(now())

  // Auto-updated timestamp
  updatedAt DateTime @updatedAt

  user              User             @relation(fields: [userId], references: [id])
  campaigns         EmailCampaign[]
  campaignSenders   CampaignSender[]
  emailJobs         EmailJob[]
  providerProfile   ProviderProfile? @relation(fields: [providerProfileId], references: [id])
  providerProfileId String?
  warmupSchedule    WarmupSchedule?
  cooldown          SenderCooldown?

  @@unique([userId, email])
  @@index([userId])
}

model EmailCampaign {
  id       String  @id @default(cuid())
  userId   String
  senderId String?

  subject String
  body    String

  startTime    DateTime
  delaySeconds Int
  hourlyLimit  Int

  totalRecipients Int
  status          CampaignStatus @default(SCHEDULED)
  pauseReason     String?
  trackOpens      Boolean        @default(true)
  trackClicks     Boolean        @default(true)

  // Timezone-aware scheduling
  timezone       String  @default("UTC")

  // Business hours enforcement
  businessStartHour Int?   // 0-23, e.g. 9 for 9 AM
  businessEndHour   Int?   // 0-23, e.g. 17 for 5 PM

  // Priority Mail — premium feature
  isPriority     Boolean @default(false)

  // Enhanced scheduling
  optimalSendTime DateTime?
  staggerConfig   Json?      // Configuration for staggered delivery

  // Campaign cloning
  clonedFromId    String?
  isCloned        Boolean @default(false)

  createdAt DateTime @default(now())

  user                    User                     @relation(fields: [userId], references: [id])
  sender                  Sender?                  @relation(fields: [senderId], references: [id])
  emails                  EmailJob[]
  attachments             Attachment[]
  sequenceSteps           SequenceStep[]
  recipientSequenceStates RecipientSequenceState[]
  campaignSenders         CampaignSender[]

  // Collaboration features
  draftShares       DraftShare[]
  draftComments     DraftComment[]
  draftVersions     DraftVersion[]
  approvalRequests  ApprovalRequest[]

  @@index([userId])
  @@index([senderId])
}

model EmailJob {
  id         String  @id @default(cuid())
  campaignId String
  senderId   String?

  toEmail        String
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus @default(PENDING)
  error          String?
  isStarred      Boolean?    @default(false)
  columnData     Json?
  isReplied      Boolean     @default(false)
  sequenceStepId String?

  // Email threading headers
  messageId   String?
  inReplyTo   String?
  references  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign     EmailCampaign @relation(fields: [campaignId], references: [id])
  sequenceStep SequenceStep? @relation(fields: [sequenceStepId], references: [id])
  sender       Sender?       @relation(fields: [senderId], references: [id])
  trackingEvents TrackingEvent[]

  @@index([campaignId])
  @@index([scheduledAt])
  @@index([status])
  @@index([senderId])
}

model CampaignSender {
  id            String @id @default(cuid())
  campaignId    String
  senderId      String
  rotationOrder Int

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender        @relation(fields: [senderId], references: [id])

  @@unique([campaignId, senderId])
  @@index([campaignId])
}

model RateLimitCounter {
  id           String    @id @default(cuid())
  senderId     String
  hourWindow   DateTime
  count        Int       @default(0)
  createdAt    DateTime  @default(now())

  minuteWindow DateTime?

  @@unique([senderId, hourWindow])
  @@unique([senderId, minuteWindow])
  @@index([senderId, hourWindow])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Attachment {
  id         String @id @default(cuid())
  campaignId String
  url        String 
  filename   String 
  size       Int 
  mimeType   String 

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model EmailTemplate {
  id      String  @id @default(cuid())
  userId  String? 
  name    String
  subject String
  body    String

  // Enhanced Template System
  isPublic  Boolean @default(false)
  category  String?
  folderId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?           @relation(fields: [userId], references: [id])
  folder    TemplateFolder? @relation(fields: [folderId], references: [id])
  versions  TemplateVersion[]
  shares    TemplateShare[]
  favorites TemplateFavorite[]

  @@unique([userId, name])
  @@index([userId])
}

model TemplateFolder {
  id        String   @id @default(cuid())
  name      String
  userId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id])
  parent    TemplateFolder?  @relation("SubFolders", fields: [parentId], references: [id])
  children  TemplateFolder[] @relation("SubFolders")
  templates EmailTemplate[]

  @@index([userId])
}

model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  subject    String
  body       String
  version    Int
  createdAt  DateTime @default(now())

  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model TemplateShare {
  id               String   @id @default(cuid())
  templateId       String
  sharedWithUserId String
  permission       String   @default("VIEW") 

  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sharedWith User          @relation("UserTemplateShares", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([templateId, sharedWithUserId])
}

model TemplateFavorite {
  id         String   @id @default(cuid())
  userId     String
  templateId String

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

model ContentSnippet {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

model EmailSignature {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model BrandKit {
  id             String  @id @default(cuid())
  userId         String  @unique
  primaryColor   String?
  secondaryColor String?
  fontFamily     String?
  logoUrl        String?
  
  user           User    @relation(fields: [userId], references: [id])
}

model SavedBlock {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model DraftShare {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  permission String   @default("VIEW") 

  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model DraftComment {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  content    String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     DraftComment? @relation("CommentThread", fields: [parentId], references: [id])
  replies    DraftComment[] @relation("CommentThread")
}

model DraftVersion {
  id         String   @id @default(cuid())
  campaignId String
  subject    String
  body       String
  version    Int
  createdAt  DateTime @default(now())

  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id         String   @id @default(cuid())
  campaignId String
  requesterId String
  approverId String
  status     String   @default("PENDING") 
  feedback   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requester  User          @relation("RequestedApprovals", fields: [requesterId], references: [id])
  approver   User          @relation("ApprovalsToGive", fields: [approverId], references: [id])
}

model TextExpander {
  id        String   @id @default(cuid())
  userId    String
  shortcut  String
  expansion String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, shortcut])
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  events    Json     
  secret    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model SequenceStep {
  id         String @id @default(cuid())
  campaignId String
  stepNumber Int
  subject    String
  body       String
  waitDays   Int // 0 for step 0 (initial), >= 1 for follow-ups

  // Enhanced sequences
  stepConditions Json?   // Conditions for this step
  abVariant      String? // A/B variant label
  senderRotation Json?   // Per-step sender rotation configuration

  campaign  EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailJobs EmailJob[]

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

model RecipientSequenceState {
  id             String  @id @default(cuid())
  campaignId     String
  recipientEmail String
  currentStep    Int     @default(0)
  paused         Boolean @default(false)
  replied        Boolean @default(false)
  completed      Boolean @default(false)
  stepStatuses   Json // Array of { stepNumber, status, sentAt, error, emailJobId }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipientEmail])
  @@index([campaignId])
  @@index([campaignId, paused, replied, completed])
}

enum CampaignStatus {
  SCHEDULED
  SENDING
  PAUSED
  CANCELLED
  COMPLETED
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

// ─── Throttling Refinement Models ────────────────────────────────────────────

model ProviderProfile {
  id              String @id @default(cuid())
  providerName    String @unique 
  smtpHostPattern String @unique 
  perMinuteLimit  Int 
  perHourLimit    Int 
  perDayLimit     Int 

  senders Sender[]
}

model WarmupSchedule {
  id           String   @id @default(cuid())
  senderId     String   @unique
  startDate    DateTime @default(now())
  durationDays Int      @default(14)
  dailyLimits  Json 
  isActive     Boolean  @default(true)
  optedOut     Boolean  @default(false)

  sender Sender @relation(fields: [senderId], references: [id])
}

model SenderCooldown {
  id                String    @id @default(cuid())
  senderId          String    @unique
  consecutiveErrors Int       @default(0)
  cooldownUntil     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sender Sender @relation(fields: [senderId], references: [id])
}

// ─── Email Tracking Models ───────────────────────────────────────────────────

model TrackingEvent {
  id          String            @id @default(cuid())
  emailJobId  String
  eventType   TrackingEventType
  url         String?           
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime          @default(now())

  emailJob EmailJob @relation(fields: [emailJobId], references: [id])

  @@index([emailJobId])
  @@index([eventType])
  @@index([emailJobId, eventType])
}

enum TrackingEventType {
  OPEN
  CLICK
  REPLY
}

// ─── Priority Mail Models ────────────────────────────────────────────────────────────────

enum PriorityStatus {
  PRIORITY_PENDING
  PRIORITY_SENDING
  SENT
  FAILED
}

model PriorityQueueJob {
  id                String        @id @default(cuid())
  emailJobId         String        @unique
  userId             String
  status             PriorityStatus @default(PRIORITY_PENDING)
  priorityScore      Int           @default(500) 
  congestionScore    Int           @default(0)    
  scheduledAt       DateTime      @default(now())
  retryCount         Int          @default(0)
  statusMessage      String?       
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model SmtpSignalLog {
  id               String   @id @default(cuid())
  senderId         String
  recipientDomain  String
  tcpConnectMs     Int      @default(0)   
  greetingDelayMs Int      @default(0)   
  tlsHandshakeMs   Int      @default(0)   
  mailFromMs       Int      @default(0)   
  rcptToMs        Int      @default(0)   
  dataMs          Int      @default(0)   
  congestionScore Int      @default(0)   
  recordedAt      DateTime @default(now())

  @@index([senderId])
  @@index([recipientDomain])
  @@index([recordedAt])
}

model PriorityUserQuota {
  userId        String   @id
  dailyCount     Int      @default(0)
  dailyLimit    Int      @default(50)  
  dailyResetAt  DateTime @default(now())
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model DomainRateLimit {
  domain        String   @id
  hourlyCount   Int      @default(0)
  windowStart  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain])
  @@index([windowStart])
}
