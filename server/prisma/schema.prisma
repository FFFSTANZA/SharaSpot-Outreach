generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  campaigns     EmailCampaign[]
  templates     EmailTemplate[]
  refreshTokens RefreshToken[]
  senders       Sender[]
  subscription  Subscription?
  tags          Tag[]
  contacts      Contact[]
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  dodoCustomerId     String?
  dodoSubscriptionId String?
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelAt           DateTime?
  trialEnd           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([dodoSubscriptionId])
  @@index([status])
}

model Sender {
  id                String           @id @default(cuid())
  userId            String
  email             String
  name              String?
  appPassword       String           @default("")
  smtpHost          String           @default("smtp.gmail.com")
  smtpPort          Int              @default(465)
  isVerified        Boolean          @default(false)
  dailyLimit        Int              @default(500)
  hourlyLimit       Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  providerProfileId String?
  campaignSenders   CampaignSender[]
  campaigns         EmailCampaign[]
  emailJobs         EmailJob[]
  providerProfile   ProviderProfile? @relation(fields: [providerProfileId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  cooldown          SenderCooldown?
  warmupSchedule    WarmupSchedule?

  @@unique([userId, email])
  @@index([userId])
}

model EmailCampaign {
  id                      String                   @id @default(cuid())
  userId                  String
  senderId                String?
  subject                 String
  body                    String
  startTime               DateTime
  delaySeconds            Int
  hourlyLimit             Int
  totalRecipients         Int
  status                  CampaignStatus           @default(SCHEDULED)
  pauseReason             String?
  trackOpens              Boolean                  @default(true)
  trackClicks             Boolean                  @default(true)
  timezone                String                   @default("UTC")
  businessStartHour       Int?
  businessEndHour         Int?
  isPriority              Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  attachments             Attachment[]
  campaignSenders         CampaignSender[]
  sender                  Sender?                  @relation(fields: [senderId], references: [id])
  user                    User                     @relation(fields: [userId], references: [id])
  emails                  EmailJob[]
  recipientSequenceStates RecipientSequenceState[]
  sequenceSteps           SequenceStep[]

  @@index([userId])
  @@index([senderId])
}

model EmailJob {
  id             String          @id @default(cuid())
  campaignId     String
  senderId       String?
  toEmail        String
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus     @default(PENDING)
  error          String?
  isStarred      Boolean?        @default(false)
  columnData     Json?
  isReplied      Boolean         @default(false)
  sequenceStepId String?
  messageId      String?
  inReplyTo      String?
  references     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  campaign       EmailCampaign   @relation(fields: [campaignId], references: [id])
  sender         Sender?         @relation(fields: [senderId], references: [id])
  sequenceStep   SequenceStep?   @relation(fields: [sequenceStepId], references: [id])
  trackingEvents TrackingEvent[]

  @@index([campaignId])
  @@index([scheduledAt])
  @@index([status])
  @@index([senderId])
}

model CampaignSender {
  id            String        @id @default(cuid())
  campaignId    String
  senderId      String
  rotationOrder Int
  campaign      EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender        Sender        @relation(fields: [senderId], references: [id])

  @@unique([campaignId, senderId])
  @@index([campaignId])
}

model RateLimitCounter {
  id           String    @id @default(cuid())
  senderId     String
  hourWindow   DateTime
  count        Int       @default(0)
  createdAt    DateTime  @default(now())
  minuteWindow DateTime?

  @@unique([senderId, hourWindow])
  @@unique([senderId, minuteWindow])
  @@index([senderId, hourWindow])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Attachment {
  id         String        @id @default(cuid())
  campaignId String
  url        String
  filename   String
  size       Int
  mimeType   String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([userId, name])
  @@index([userId])
}

model SequenceStep {
  id         String        @id @default(cuid())
  campaignId String
  stepNumber Int
  subject    String
  body       String
  waitDays   Int
  emailJobs  EmailJob[]
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

model RecipientSequenceState {
  id             String        @id @default(cuid())
  campaignId     String
  recipientEmail String
  currentStep    Int           @default(0)
  paused         Boolean       @default(false)
  replied        Boolean       @default(false)
  completed      Boolean       @default(false)
  stepStatuses   Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  campaign       EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipientEmail])
  @@index([campaignId])
  @@index([campaignId, paused, replied, completed])
}

model ProviderProfile {
  id              String   @id @default(cuid())
  providerName    String   @unique
  smtpHostPattern String   @unique
  perMinuteLimit  Int
  perHourLimit    Int
  perDayLimit     Int
  senders         Sender[]
}

model WarmupSchedule {
  id           String   @id @default(cuid())
  senderId     String   @unique
  startDate    DateTime @default(now())
  durationDays Int      @default(14)
  dailyLimits  Json
  isActive     Boolean  @default(true)
  optedOut     Boolean  @default(false)
  sender       Sender   @relation(fields: [senderId], references: [id])
}

model SenderCooldown {
  id                String    @id @default(cuid())
  senderId          String    @unique
  consecutiveErrors Int       @default(0)
  cooldownUntil     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sender            Sender    @relation(fields: [senderId], references: [id])
}

model TrackingEvent {
  id         String            @id @default(cuid())
  emailJobId String
  eventType  TrackingEventType
  url        String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime          @default(now())
  emailJob   EmailJob          @relation(fields: [emailJobId], references: [id])

  @@index([emailJobId])
  @@index([eventType])
  @@index([emailJobId, eventType])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  ON_HOLD
}

enum CampaignStatus {
  SCHEDULED
  SENDING
  PAUSED
  CANCELLED
  COMPLETED
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum TrackingEventType {
  OPEN
  CLICK
  REPLY
}

model PriorityQueueJob {
  emailJobId      String         @id
  userId          String
  status          PriorityStatus @default(PRIORITY_PENDING)
  statusMessage   String?
  retryCount      Int            @default(0)
  priorityScore   Int            @default(500)
  congestionScore Int            @default(0)
  scheduledAt     DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

model SmtpSignalLog {
  id              String   @id @default(cuid())
  senderId        String
  recipientDomain String
  tcpConnectMs    Float
  greetingDelayMs Float
  tlsHandshakeMs  Float
  mailFromMs      Float
  rcptToMs        Float
  dataMs          Float
  congestionScore Int
  recordedAt      DateTime @default(now())

  @@index([senderId])
  @@index([recipientDomain])
  @@index([recordedAt])
}

enum PriorityStatus {
  PRIORITY_PENDING
  PRIORITY_SENDING
  SENT
  FAILED
}

model PriorityUserQuota {
  id           String   @id @default(cuid())
  userId       String   @unique
  dailyCount   Int      @default(0)
  dailyLimit   Int      @default(50)
  dailyResetAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model DomainRateLimit {
  id          String   @id @default(cuid())
  domain      String   @unique
  hourlyCount Int      @default(0)
  windowStart DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain])
}

model Tag {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts  Contact[] @relation("ContactToTag")

  @@unique([userId, name])
  @@index([userId])
}

model Contact {
  id         String            @id @default(cuid())
  userId     String
  email      String
  firstName  String?
  lastName   String?
  company    String?
  jobTitle   String?
  stage      String            @default("COLD")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities ContactActivity[]
  notes      Note[]
  tags       Tag[]             @relation("ContactToTag")

  @@unique([userId, email])
  @@index([userId])
  @@index([email])
}

model Note {
  id        String   @id @default(cuid())
  contactId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactActivity {
  id        String   @id @default(cuid())
  contactId String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}
