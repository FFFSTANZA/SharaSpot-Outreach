generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  campaigns     EmailCampaign[]
  templates     EmailTemplate[]
  followUpTemplates FollowUpTemplate[]
  refreshTokens RefreshToken[]
  senders       Sender[]
  subscription  Subscription?
  tags          Tag[]
  contacts      Contact[]
  contactLists  ContactList[]
  mcpApiKeys    McpApiKey[]
  bounceList    BounceList[]
  prmSegments   PrmSegment[]
  prmBulkActionLogs PrmBulkActionLog[]
  callTasks     CallTask[]
  callingEnabled Boolean @default(false)
  callProviderConnections CallProviderConnection[]
  callSessions CallSession[]
  organizationMemberships OrganizationMember[]
  ownedOrganizations     Organization[]       @relation("OrganizationOwner")
  activeOrganizationId   String?
  activeOrganization     Organization?        @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String
  owner     User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  users     User[]   @relation("ActiveOrganization")
  members   OrganizationMember[]
  invites   OrganizationInvite[]
  campaigns     EmailCampaign[]
  contacts      Contact[]
  senders       Sender[]
  templates     EmailTemplate[]
  followUpTemplates FollowUpTemplate[]
  contactLists  ContactList[]
  tags          Tag[]
  callTasks     CallTask[]
  prmSegments   PrmSegment[]
  webhooks      Webhook[]
  mcpApiKeys    McpApiKey[]
  bounceList    BounceList[]
  inboxEmails   InboxEmail[]
  inboxThreads  InboxThread[]

  @@index([ownerId])
}

model OrganizationMember {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  role           OrgMemberRole   @default(MEMBER)
  invitedBy      String?
  joinedAt       DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model OrganizationInvite {
  id             String        @id @default(cuid())
  organizationId String
  email          String
  role           OrgMemberRole @default(MEMBER)
  tokenHash      String        @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
  @@index([organizationId, acceptedAt, revokedAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  dodoCustomerId     String?
  dodoSubscriptionId String?
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelAt           DateTime?
  trialEnd           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([dodoSubscriptionId])
  @@index([status])
}

model Sender {
  id                 String              @id @default(cuid())
  userId             String
  organizationId     String?
  email              String
  name               String?
  appPassword        String              @default("")
  smtpHost           String              @default("smtp.gmail.com")
  smtpPort           Int                 @default(465)
  replyTo            String?
  isVerified         Boolean             @default(false)
  dailyLimit         Int                 @default(500)
  hourlyLimit        Int?
  accessToken        String?
  refreshToken       String?
  tokenExpiresAt     DateTime?
  connectionType     InboxConnectionType @default(IMAP)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  providerProfileId  String?
  campaignSenders    CampaignSender[]
  campaigns          EmailCampaign[]
  emailJobs          EmailJob[]
  providerProfile    ProviderProfile?    @relation(fields: [providerProfileId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  organization       Organization?       @relation(fields: [organizationId], references: [id])
  cooldown           SenderCooldown?
  warmupSchedule     WarmupSchedule?
  analyticsSnapshots AnalyticsSnapshot[]
  dailyHealth        DailySenderHealth[]
  inboxEmails        InboxEmail[]
  inboxThreads       InboxThread[]
  inboxSyncJobs      InboxSyncJob[]

  @@unique([userId, email])
  @@index([userId])
  @@index([organizationId])
}

model EmailCampaign {
  id                      String                   @id @default(cuid())
  userId                  String
  organizationId          String?
  senderId                String?
  subject                 String
  body                    String
  replyTo                 String?
  startTime               DateTime
  delaySeconds            Int
  hourlyLimit             Int
  totalRecipients         Int
  status                  CampaignStatus           @default(SCHEDULED)
  pauseReason             String?
  trackOpens              Boolean                  @default(true)
  trackClicks             Boolean                  @default(true)
  timezone                String                   @default("UTC")
  businessStartHour       Int?
  businessEndHour         Int?
  isPriority              Boolean                  @default(false)
  sequenceConfig          Json?
  createdAt               DateTime                 @default(now())
  attachments             Attachment[]
  campaignSenders         CampaignSender[]
  sender                  Sender?                  @relation(fields: [senderId], references: [id])
  user                    User                     @relation(fields: [userId], references: [id])
  organization            Organization?            @relation(fields: [organizationId], references: [id])
  emails                  EmailJob[]
  recipientSequenceStates RecipientSequenceState[]
  sequenceSteps           SequenceStep[]
  analyticsSnapshots      AnalyticsSnapshot[]
  callTasks               CallTask[]

  @@index([userId])
  @@index([organizationId])
  @@index([senderId])
}

model EmailJob {
  id             String          @id @default(cuid())
  campaignId     String
  senderId       String?
  toEmail        String
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus     @default(PENDING)
  error          String?
  isStarred      Boolean?        @default(false)
  columnData     Json?
  isReplied      Boolean         @default(false)
  sequenceStepId String?
  messageId      String?
  inReplyTo      String?
  references     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  campaign       EmailCampaign   @relation(fields: [campaignId], references: [id])
  sender         Sender?         @relation(fields: [senderId], references: [id])
  sequenceStep   SequenceStep?   @relation(fields: [sequenceStepId], references: [id])
  trackingEvents TrackingEvent[]

  @@index([campaignId])
  @@index([scheduledAt])
  @@index([status])
  @@index([senderId])
  @@index([createdAt])
  @@index([campaignId, status])
}

model CampaignSender {
  id            String        @id @default(cuid())
  campaignId    String
  senderId      String
  rotationOrder Int
  campaign      EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender        Sender        @relation(fields: [senderId], references: [id])

  @@unique([campaignId, senderId])
  @@index([campaignId])
}

model RateLimitCounter {
  id           String   @id @default(cuid())
  senderId     String
  hourWindow   DateTime
  count        Int      @default(0)
  createdAt    DateTime @default(now())
  minuteWindow DateTime @default(now())

  @@unique([senderId, hourWindow])
  @@unique([senderId, minuteWindow])
  @@index([senderId, hourWindow])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Attachment {
  id         String        @id @default(cuid())
  campaignId String
  url        String
  filename   String
  size       Int
  mimeType   String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model EmailTemplate {
  id              String   @id @default(cuid())
  userId          String?
  organizationId  String?
  name            String
  subject         String
  body            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?           @relation(fields: [userId], references: [id])
  organization    Organization?   @relation(fields: [organizationId], references: [id])

  @@unique([userId, name])
  @@index([userId])
  @@index([organizationId])
}

model FollowUpTemplate {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  name           String
  description    String?
  steps          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, name])
  @@index([userId])
  @@index([organizationId])
}

model SequenceStep {
  id         String        @id @default(cuid())
  campaignId String
  stepNumber Int
  subject    String
  body       String
  waitDays   Int
  condition  String?
  emailJobs  EmailJob[]
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

model RecipientSequenceState {
  id             String        @id @default(cuid())
  campaignId     String
  recipientEmail String
  currentStep    Int           @default(0)
  paused         Boolean       @default(false)
  replied        Boolean       @default(false)
  completed      Boolean       @default(false)
  stepStatuses   Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  campaign       EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipientEmail])
  @@index([campaignId])
  @@index([campaignId, paused, replied, completed])
}

model ProviderProfile {
  id              String   @id @default(cuid())
  providerName    String   @unique
  smtpHostPattern String   @unique
  perMinuteLimit  Int
  perHourLimit    Int
  perDayLimit     Int
  senders         Sender[]
}

model WarmupSchedule {
  id           String   @id @default(cuid())
  senderId     String   @unique
  startDate    DateTime @default(now())
  durationDays Int      @default(14)
  dailyLimits  Json
  isActive     Boolean  @default(true)
  optedOut     Boolean  @default(false)
  sender       Sender   @relation(fields: [senderId], references: [id])
}

model SenderCooldown {
  id                String    @id @default(cuid())
  senderId          String    @unique
  consecutiveErrors Int       @default(0)
  cooldownUntil     DateTime?
  quarantinedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sender            Sender    @relation(fields: [senderId], references: [id])
}

model TrackingEvent {
  id            String            @id @default(cuid())
  emailJobId    String
  eventType     TrackingEventType
  url           String?
  ipAddress     String?
  userAgent     String?
  platform      String?
  browser       String?
  isMobile      Boolean?
  isDesktop     Boolean?
  isBot         Boolean?
  trackingToken String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  createdAt     DateTime          @default(now())
  emailJob      EmailJob          @relation(fields: [emailJobId], references: [id])

  @@index([emailJobId])
  @@index([eventType])
  @@index([emailJobId, eventType])
  @@index([createdAt])
  @@index([platform])
  @@index([trackingToken])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  ON_HOLD
}

enum CampaignStatus {
  SCHEDULED
  SENDING
  PAUSED
  CANCELLED
  COMPLETED
}

model PriorityQueueJob {
  emailJobId      String         @id
  userId          String
  status          PriorityStatus @default(PRIORITY_PENDING)
  statusMessage   String?
  retryCount      Int            @default(0)
  priorityScore   Int            @default(500)
  congestionScore Int            @default(0)
  scheduledAt     DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, scheduledAt])
}

model SmtpSignalLog {
  id              String   @id @default(cuid())
  senderId        String
  recipientDomain String
  tcpConnectMs    Float
  greetingDelayMs Float
  tlsHandshakeMs  Float
  mailFromMs      Float
  rcptToMs        Float
  dataMs          Float
  congestionScore Int
  recordedAt      DateTime @default(now())

  @@index([senderId])
  @@index([recipientDomain])
  @@index([recordedAt])
  @@index([senderId, recordedAt])
  @@index([recipientDomain, recordedAt])
}

enum PriorityStatus {
  PRIORITY_PENDING
  PRIORITY_SENDING
  SENT
  FAILED
}

model PriorityUserQuota {
  id           String   @id @default(cuid())
  userId       String   @unique
  dailyCount   Int      @default(0)
  dailyLimit   Int      @default(50)
  dailyResetAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model DomainRateLimit {
  id          String   @id @default(cuid())
  domain      String   @unique
  hourlyCount Int      @default(0)
  windowStart DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id              String      @id @default(cuid())
  userId          String
  organizationId  String?
  name            String
  color           String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])
  contacts        Contact[]   @relation("ContactToTag")

  @@unique([userId, name])
  @@index([userId])
  @@index([organizationId])
}

model Contact {
  id              String            @id @default(cuid())
  userId          String
  organizationId  String?
  email           String
  firstName       String?
  lastName        String?
  company         String?
  phone           String?
  jobTitle        String?
  stage           String            @default("COLD")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?     @relation(fields: [organizationId], references: [id])
  activities      ContactActivity[]
  notes           Note[]
  tags            Tag[]             @relation("ContactToTag")
  lists           ContactList[]     @relation("ContactToContactList")
  segmentMemberships PrmSegmentContact[]
  callTasks           CallTask[]
  callSessions        CallSession[]

  @@unique([userId, email])
  @@index([userId])
  @@index([organizationId])
  @@index([email])
  @@index([userId, email])
  @@index([userId, stage])
}

model CallTask {
  id          String         @id @default(cuid())
  userId      String
  organizationId String?
  contactId   String
  status      CallTaskStatus @default(PENDING)
  priority    Int            @default(0)
  dueAt       DateTime
  lastOutcome String?
  lastDisposition String?
  lastNote    String?
  campaignId String?
  contactListId String?
  prmSegmentId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  contact     Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign    EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contactList ContactList?   @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  prmSegment  PrmSegment?    @relation(fields: [prmSegmentId], references: [id], onDelete: SetNull)
  callSessions CallSession[]

  @@index([userId, status, dueAt])
  @@index([organizationId])
  @@index([contactId])
  @@index([userId, dueAt])
  @@index([campaignId])
  @@index([contactListId])
  @@index([prmSegmentId])
}

model CallProviderConnection {
  id                String             @id @default(cuid())
  userId            String
  type              CallProviderType   @default(SIP_WEBRTC)
  name              String
  sipUsernameEnc    String
  sipPasswordEnc    String
  sipDomain         String
  websocketUrl      String
  displayName       String?
  vendorMetadata    Json?
  status            CallProviderStatus @default(REQUIRES_ATTENTION)
  lastCheckedAt     DateTime?
  lastError         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  callSessions      CallSession[]

  @@index([userId])
  @@index([userId, status])
}

model CallSession {
  id                   String          @id @default(cuid())
  userId               String
  contactId            String?
  taskId               String?
  providerConnectionId String?
  mode                 CallSessionMode @default(MANUAL)
  direction            CallDirection   @default(OUTBOUND)
  providerCallId       String?
  outcome              String?
  note                 String?
  startedAt            DateTime        @default(now())
  endedAt              DateTime?
  durationSeconds      Int?
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact              Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  task                 CallTask?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  providerConnection   CallProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([contactId])
  @@index([taskId])
  @@index([providerConnectionId])
  @@index([userId, startedAt])
}

model PrmSegment {
  id              String      @id @default(cuid())
  userId          String
  organizationId  String?
  name            String
  expression      Json
  isAdhoc         Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])
  contacts        PrmSegmentContact[]
  callTasks       CallTask[]

  @@index([userId])
  @@index([organizationId])
  @@unique([userId, name])
}

model PrmSegmentContact {
  id         String   @id @default(cuid())
  segmentId  String
  contactId  String
  createdAt  DateTime @default(now())
  segment    PrmSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([segmentId, contactId])
  @@index([segmentId])
  @@index([contactId])
}

model PrmBulkActionLog {
  id            String   @id @default(cuid())
  userId        String
  actionType    String
  payload       Json
  affectedCount Int
  undoToken     String?  @unique
  undoneAt      DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  contactId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactActivity {
  id        String   @id @default(cuid())
  contactId String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([createdAt])
  @@index([contactId, createdAt])
}

model ContactList {
  id              String      @id @default(cuid())
  userId          String
  organizationId  String?
  name            String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])
  contacts        Contact[]   @relation("ContactToContactList")
  callTasks       CallTask[]

  @@unique([userId, name])
  @@index([userId])
  @@index([organizationId])
}

model AnalyticsSnapshot {
  id         String       @id @default(cuid())
  campaignId String?
  senderId   String?
  timestamp  DateTime     @default(now())
  type       SnapshotType @default(HOURLY)

  sentCount   Int @default(0)
  openCount   Int @default(0)
  clickCount  Int @default(0)
  replyCount  Int @default(0)
  bounceCount Int @default(0)

  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender?        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([campaignId, senderId, timestamp, type])
  @@index([campaignId])
  @@index([senderId])
  @@index([timestamp])
  @@index([campaignId, timestamp])
  @@index([senderId, timestamp])
}

enum SnapshotType {
  HOURLY
  DAILY
}

model DailySenderHealth {
  id       String   @id @default(cuid())
  senderId String
  date     DateTime @default(now())

  successCount Int   @default(0)
  errorCount   Int   @default(0)
  bounceCount  Int   @default(0)
  errorDetails Json?

  sender Sender @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, date])
  @@index([senderId])
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum TrackingEventType {
  OPEN
  CLICK
  REPLY
  BOUNCE
}

model Webhook {
  id              String      @id @default(cuid())
  userId          String
  organizationId  String?
  url             String
  name            String?
  events          String[]
  secret          String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([isActive])
  @@index([userId, isActive])
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  webhookId      String
  eventType      String
  payload        Json
  responseStatus Int?
  responseBody   String?
  errorMessage   String?
  attempts       Int       @default(0)
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([webhookId])
  @@index([createdAt])
}

enum InboxConnectionType {
  IMAP
  GMAIL_API
  MICROSOFT_GRAPH
}

enum CallTaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum CallProviderType {
  SIP_WEBRTC
}

enum CallProviderStatus {
  CONNECTED
  FAILED
  REQUIRES_ATTENTION
  DISCONNECTED
}

enum CallSessionMode {
  MANUAL
  CONNECTED
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

model InboxEmail {
  id              String      @id @default(cuid())
  senderId        String
  organizationId  String?
  messageId       String
  inReplyTo       String?
  references      String?
  threadId        String?
  fromName        String?
  fromEmail       String
  toName          String?
  toEmail         String
  subject         String
  bodyText        String?
  bodyHtml        String?
  snippet         String      @db.Text
  isRead          Boolean     @default(false)
  isStarred       Boolean     @default(false)
  isArchived      Boolean     @default(false)
  isDeleted       Boolean     @default(false)
  folder          String      @default("INBOX")
  receivedAt      DateTime
  syncedAt        DateTime    @default(now())
  syncedBy        String?
  sender          Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@unique([senderId, messageId])
  @@index([senderId])
  @@index([organizationId])
  @@index([threadId])
  @@index([receivedAt])
  @@index([toEmail])
  @@index([senderId, receivedAt])
  @@index([senderId, fromEmail, subject])
}

model InboxThread {
  id              String      @id @default(cuid())
  senderId        String
  organizationId  String?
  threadId        String
  subject         String
  participants    String[]
  lastMessageAt   DateTime
  lastSnippet     String?
  lastSenderEmail String?
  unreadCount     Int         @default(0)
  hasAttachments  Boolean     @default(false)
  sender          Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@unique([senderId, threadId])
  @@index([senderId])
  @@index([organizationId])
  @@index([lastMessageAt])
  @@index([senderId, lastMessageAt])
}

enum InboxSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model InboxSyncJob {
  id                String          @id @default(cuid())
  senderId          String
  status            InboxSyncStatus @default(PENDING)
  messagesProcessed Int             @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  error             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sender            Sender          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([status])
}

model McpApiKey {
  id              String      @id @default(cuid())
  userId          String
  organizationId  String?
  name            String
  keyHash         String      @unique
  permissions     Json        @default("{}")
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, name])
  @@index([userId])
  @@index([organizationId])
  @@index([keyHash])
}

model SystemAuditLog {
  id        String   @id @default(cuid())
  level     LogLevel @default(INFO)
  category  String // e.g. "INFRASTRUCTURE", "CAMPAIGN", "SENDER"
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([category])
  @@index([createdAt])
}

enum LogLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

model ProcessedWebhook {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model BounceList {
  id              String      @id @default(cuid())
  userId          String
  organizationId  String?
  email           String
  bouncedAt       DateTime    @default(now())
  bounceCode      String?
  reason          String?
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, email])
  @@index([userId])
  @@index([organizationId])
  @@index([email])
}
