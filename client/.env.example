# ─── SharaSpot Client ───

# Backend API URL (your VPS domain or IP)
NEXT_PUBLIC_BACKEND_URL=https://sharaspot.in

# Google sign-in Client ID
# Replace with your actual Google OAuth Client ID from Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SEO / Site URL (production: https://sharaspot.in)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification code (the "content" value from verification meta tag)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
